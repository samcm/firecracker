{
  "boot-source": {
    "kernel_image_path": "vmlinux.bin",
    "boot_args": "console=ttyS0 reboot=k panic=1 swiotlb=noforce"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "fd": 4,
      "is_root_device": true,
      "is_read_only": true
    }
  ],
  "machine-config": {
    "mem_size_mib": 1024,
    "smt": false
  }
}
